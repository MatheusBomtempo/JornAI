# ─────────────────────────────────────────────────────────────
# JornAI — environment variables
# Copy this file to `.env` and fill in the real values.
# ─────────────────────────────────────────────────────────────

# ── Working language ─────────────────────────────────────────
# The language JornAI works in: the language of the sources and of the posts
# the AI writes. It also drives language-specific rules (personal-data
# redaction, date/weekday handling, the factual validator) and is the default
# interface language.
#   pt -> Brazilian Portuguese (default when unset)
#   en -> English
APP_LANGUAGE="pt"

# ── Database (PostgreSQL) ────────────────────────────────────
DATABASE_URL="postgresql://jornai:jornai@localhost:5432/jornai?schema=public"
# Direct connection (no pooler), only used by `prisma migrate`/`db push`.
# On a regular Postgres with no pooler (e.g. local), use the SAME value as DATABASE_URL.
# On Neon, DATABASE_URL is the "Pooled" connection string and DIRECT_URL is the "Direct" one
# (both show up in the Neon dashboard, Connect tab).
DIRECT_URL="postgresql://jornai:jornai@localhost:5432/jornai?schema=public"

# ── Authentication ───────────────────────────────────────────
# Secret used to sign the session JWTs. Generate a strong value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="replace-with-a-strong-random-secret"
# Session duration (in seconds). Default: 7 days.
AUTH_SESSION_TTL="604800"
# Authenticates Vercel Cron on /api/cron/* (Vercel sends this value by itself
# as "Authorization: Bearer ..." on crons — without it the endpoint is open to
# anyone). Generate it with the same command as AUTH_SECRET.
CRON_SECRET=""

# ── AI provider (text) ───────────────────────────────────────
# Provider: "chain" | "mock" | "groq" | "gemini" | "nvidia" | "openrouter" |
#           "openai" | "anthropic"
#   chain      -> chain with fallback: tries Groq, then OpenRouter (each model
#                 in the list, in order); if a provider goes down/hits a rate
#                 limit, it moves on to the next automatically — RECOMMENDED
#                 as soon as you have 2+ free keys configured.
#   mock       -> runs the flow with no key at all (dev)
#   groq       -> stable free tier, fast, OpenAI-compatible
#   gemini     -> Google AI Studio, generous free quota
#   nvidia     -> NIM (integrate.api.nvidia.com) — check which models your key
#                 actually has enabled before using it (the public catalog
#                 lists many that return 404 for your account)
#   openrouter -> OpenAI-compatible gateway (has ":free" models)
#   openai     -> official OpenAI API
#   anthropic  -> Anthropic API (Claude)
AI_PROVIDER="mock"
# Model ID ON THE CHOSEN provider (used in the single-provider modes — in
# "chain" mode use the specific *_MODEL/*_MODELS variables below):
#   groq       -> e.g. openai/gpt-oss-20b     (see console.groq.com/docs/models)
#   gemini     -> e.g. gemini-2.0-flash
#   openrouter -> e.g. nex-agi/nex-n2.5-mini:free (see openrouter.ai/models, $0 filter)
#   openai     -> e.g. gpt-4o-mini
#   anthropic  -> e.g. claude-sonnet-5
AI_MODEL="openai/gpt-oss-20b"

# Fill in the keys of the providers you are going to use:
# GROQ_API_KEY="gsk_..."             # https://console.groq.com/keys
# GROQ_MODEL="openai/gpt-oss-20b"    # optional, used in "chain" mode

# OPENROUTER_API_KEY="sk-or-..."     # https://openrouter.ai/keys
# Models tried in order in "chain" mode (comma-separated):
# OPENROUTER_MODELS="nex-agi/nex-n2.5-mini:free,nex-agi/nex-n2.5-pro:free,inclusionai/ling-3.0-flash-vl:free"

# NVIDIA_API_KEY="nvapi-..."         # https://build.nvidia.com
# NVIDIA_MODEL=""                    # only joins the chain if you set this

# GEMINI_API_KEY="..."               # https://aistudio.google.com/apikey
# ANTHROPIC_API_KEY="sk-ant-..."     # https://console.anthropic.com
# OPENAI_API_KEY="sk-..."            # https://platform.openai.com/api-keys
# OPENAI_BASE_URL="https://api.openai.com/v1"

# ── Media storage ────────────────────────────────────────────
# Provider: "local" (default, saves to ./public/uploads) | "s3"
STORAGE_PROVIDER="local"
# Public base used to build URLs in local mode:
PUBLIC_BASE_URL="http://localhost:3000"

# --- S3 / R2 / Supabase Storage (only if STORAGE_PROVIDER=s3) ---
# S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="jornai"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL="https://cdn.your-domain.com"   # public base of the bucket
# S3_FORCE_PATH_STYLE="true"
#
# Video upload uses a direct PUT to the bucket with a signed URL (see
# lib/storage.ts presignPut) — the body never goes through Vercel's function,
# which has a payload ceiling much lower than the 100 MB the app accepts. For
# that to work, the bucket has to accept PUT via CORS from the browser. In the
# R2 bucket dashboard (Settings → CORS Policy), add:
#   [{
#     "AllowedOrigins": ["*"],
#     "AllowedMethods": ["PUT"],
#     "AllowedHeaders": ["*"],
#     "MaxAgeSeconds": 3000
#   }]
# ("*" instead of the exact domain because Vercel generates a new preview URL
# on every deploy; the PUT only works with the signed URL anyway, so opening
# the origin does not really open a hole.)

# ── Built-in photo search (Pexels) ───────────────────────────
# Optional. Without this key, the "Free photos" button in the Image step only
# opens the Pexels search in a new tab (as it always did); with it, the search
# shows up inside the site itself and the chosen photo is already downloaded
# and attached to the post — without leaving the screen. Free key (200
# searches/hour): https://www.pexels.com/api/
# PEXELS_API_KEY=""

# ── Instagram Graph API (Meta) ───────────────────────────────
# Instagram Business/Creator account linked to a Facebook Page.
IG_USER_ID=""
IG_ACCESS_TOKEN=""
# Graph API version:
IG_GRAPH_VERSION="v21.0"

# ── Email (Gmail SMTP) ───────────────────────────────────────
# Only used by admin/manager to create an account / reset someone's password
# and send the new login by email (Admin → Users). It sends through Gmail —
# works for any recipient with no verified domain needed (unlike a provider
# such as Resend), but goes out as a personal sender.
GMAIL_USER="your-email@gmail.com"
# Generate it at myaccount.google.com/apppasswords (requires 2-step
# verification enabled on the account). It is NOT the regular Google password.
GMAIL_APP_PASSWORD=""
