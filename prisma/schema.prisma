// JornAI — database schema (PostgreSQL)
// Mapped 1:1 from SPEC.md. The "status"/"origin"/"decision" fields stay as String
// (validated in the app via Zod) to match the SPEC exactly; user_role is an enum.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (pgbouncer) — usado em runtime
  directUrl = env("DIRECT_URL") // direct connection — only used by `prisma migrate`
}

enum UserRole {
  admin
  manager
  staff

  @@map("user_role")
}

/**
 * A company/newsroom — each one has its own feed, templates, style and
 * settings, fully isolated from the others (multi-tenant). Created by the
 * admin on the first login (see /onboarding); every user created afterwards
 * inherits the companyId of whoever created them.
 */
model Company {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  logoUrl         String?  @map("logo_url")
  /** Instagram @ of the company (with the at-sign), e.g. "@mynewspaper". Optional. */
  instagramHandle String?  @map("instagram_handle")
  /**
   * Brand colors (hex, e.g. "#0f172a") — used in the video templates
   * (see VIDEO_CARD_STYLES). Dark and light: if not configured, the templates
   * fall back to a neutral default. brandColorAccent is optional and is not
   * used by any template yet.
   */
  brandColorDark   String? @map("brand_color_dark")
  brandColorLight  String? @map("brand_color_light")
  brandColorAccent String? @map("brand_color_accent")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  users         User[]
  posts         Post[]
  templates     ArtTemplate[]
  styleExamples StyleExample[]
  apiKeys       ApiKey[]
  settings      AppSettings?

  @@map("companies")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(staff)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /** Last time an admin/manager reset the password and sent it by email. */
  passwordResetAt DateTime? @map("password_reset_at") @db.Timestamptz(6)
  /** Null only before onboarding (freshly created admin, no company yet). */
  companyId    String?  @map("company_id") @db.Uuid

  company          Company?         @relation(fields: [companyId], references: [id])
  posts            Post[]
  apiKeysCreated   ApiKey[]
  reviewDecisions  ReviewDecision[]
  postVersions     PostVersion[]
  styleExamples    StyleExample[]
  styleReferences  StyleReference[] // legado

  @@map("users")
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  keyHash    String    @map("key_hash")
  scopes     String[]
  companyId  String    @map("company_id") @db.Uuid
  createdBy  String?   @map("created_by") @db.Uuid
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])
  creator User?   @relation(fields: [createdBy], references: [id])

  @@index([companyId])
  @@map("api_keys")
}

model Post {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  createdBy      String   @map("created_by") @db.Uuid
  region         String?
  sourceType     String   @map("source_type") // 'photo' | 'text' | 'link'
  sourceText     String?  @map("source_text")
  sourceUrl      String?  @map("source_url")
  scrapedContent String?  @map("scraped_content")
  /** Credits/tags: [{ type: 'photo'|'source'|..., handle: '@someone' }] */
  credits        Json?
  status         String   @default("processing_ai")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company  Company       @relation(fields: [companyId], references: [id])
  author   User          @relation(fields: [createdBy], references: [id])
  photos   PostPhoto[]
  videos   PostVideo[]
  versions PostVersion[]

  @@index([status])
  @@index([createdBy])
  @@index([companyId])
  @@map("posts")
}

model PostPhoto {
  id         String   @id @default(uuid()) @db.Uuid
  postId     String   @map("post_id") @db.Uuid
  storageUrl String   @map("storage_url") // original photo, unedited
  orderIndex Int?     @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  post            Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  selectedInVersions PostVersion[]

  @@map("post_photos")
}

/**
 * Original uploaded video (before the render with the animated text). Same
 * pattern as PostPhoto: it only attaches, which one to use is a manual choice.
 */
model PostVideo {
  id         String   @id @default(uuid()) @db.Uuid
  postId     String   @map("post_id") @db.Uuid
  storageUrl String   @map("storage_url")
  durationMs Int?     @map("duration_ms")
  /** Middle frame of the video, already in 9:16 — background of the preview in the editor. */
  previewFrameUrl String? @map("preview_frame_url")
  /** Dimensions of the uploaded file — used to warn how much the 9:16 will crop. */
  width      Int?
  height     Int?
  orderIndex Int?     @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  post               Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  selectedInVersions PostVersion[]

  @@map("post_videos")
}

model ArtTemplate {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  name            String
  canvasWidth     Int      @default(1080) @map("canvas_width")
  canvasHeight    Int      @default(1080) @map("canvas_height") // or 1350 for the 4:5 format
  overlayAssetUrl String   @map("overlay_asset_url")
  photoSlot       Json     @map("photo_slot") // { x, y, width, height }
  /** Slot of the art title (max. 69 characters). */
  titleSlot       Json     @map("text_slot")
  /** Slot of the subtitle, right below the title (max. 149 characters). */
  subtitleSlot    Json?    @map("subtitle_slot")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company  Company       @relation(fields: [companyId], references: [id])
  versions PostVersion[]

  @@index([companyId])
  @@map("art_templates")
}

/**
 * LEGACY — replaced by StyleExample. Kept only so as not to destroy existing
 * data; no part of the app reads or writes this table. It can be removed in a
 * future migration, whenever you want.
 */
model StyleReference {
  id               Int      @id @default(1)
  exampleTitle     String?  @map("example_title")
  exampleShortNews String?  @map("example_short_news")
  exampleCaption   String?  @map("example_caption")
  exampleArtText   String?  @map("example_art_text")
  updatedBy        String?  @map("updated_by") @db.Uuid
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  editor User? @relation(fields: [updatedBy], references: [id])

  @@map("style_reference")
}

/**
 * Style reference examples. The AI imitates the tone/format of these real
 * posts from the newspaper (it does not copy the content).
 */
model StyleExample {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  title      String? // art title (max. 69)
  subtitle   String? // art subtitle (max. 149)
  caption    String? // legenda completa do Instagram
  orderIndex Int      @default(0) @map("order_index")
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])
  author  User?   @relation(fields: [createdBy], references: [id])

  @@index([companyId])
  @@map("style_examples")
}

model PostVersion {
  id               String   @id @default(uuid()) @db.Uuid
  postId           String   @map("post_id") @db.Uuid
  versionNumber    Int      @map("version_number")
  origin           String // 'ai_generated' | 'manual_edit' | 'ai_regenerated'
  /** Art title (max. 69 characters). */
  title            String?
  /** Art subtitle, below the title (max. 149 characters). */
  subtitle         String?
  shortNews        String?  @map("short_news") // legacy, unused
  instagramCaption String?  @map("instagram_caption")
  artText          String?  @map("art_text") // legacy, unused
  /** Provider that generated the text of this version (e.g. "groq", "openrouter:..."). Null on a manual edit. */
  aiProvider       String?  @map("ai_provider")
  /** Model used by the provider above (e.g. "openai/gpt-oss-20b"). */
  aiModel          String?  @map("ai_model")
  selectedPhotoId  String?  @map("selected_photo_id") @db.Uuid
  photoTransform   Json?    @map("photo_transform") // { offsetX, offsetY, scale }
  /** Offset of the title relative to the template's default position. */
  titleOffset      Json?    @map("title_offset") // { offsetX, offsetY }
  /** Offset of the subtitle relative to the template's default position. */
  subtitleOffset   Json?    @map("subtitle_offset") // { offsetX, offsetY }
  artTemplateId    String?  @map("art_template_id") @db.Uuid
  renderedArtUrl   String?  @map("rendered_art_url")
  /** Exactly 2 image-search suggestions generated by the AI (e.g. ["police car patrol", "gun on table"]). Auxiliary — never selects or publishes a photo on its own. */
  imageSuggestions Json?    @map("image_suggestions")
  /** Original video chosen (video post, instead of a photo). */
  selectedVideoId  String?  @map("selected_video_id") @db.Uuid
  /**
   * Fixed template of the video title card ('classic' | 'light' | 'bold').
   * Unlike ArtTemplate (photo): there are only 3 ready-made styles in the code,
   * with no builder — hence a free string instead of a relation. Default "bold"
   * (the 3rd, see DEFAULT_VIDEO_TEMPLATE in render/video-layout.ts) — keeps the
   * 3 defaults (database, validation and UI) aligned.
   */
  videoTemplate    String   @default("bold") @map("video_template")
  /**
   * Final video already rendered (text with entry/exit animation burned into
   * the frames) — THIS is the one that goes to Instagram, never the original.
   */
  renderedVideoUrl String?  @map("rendered_video_url")
  /**
   * Carousel: photos 2..N, in order — [{ photoId, transform: { offsetX,
   * offsetY, scale } }]. Only the cover (selectedPhotoId + template) carries
   * the template and text; these go out as the bare photo, cropped to the
   * cover's proportion (Instagram requires the same one for every item).
   * Null/empty = a regular single-image post.
   */
  carouselSlides   Json?    @map("carousel_slides")
  /** Rendered JPEGs of carouselSlides, same order — published after the cover art. */
  renderedSlideUrls String[] @default([]) @map("rendered_slide_urls")
  editedBy         String?  @map("edited_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  post          Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  selectedPhoto PostPhoto?       @relation(fields: [selectedPhotoId], references: [id])
  selectedVideo PostVideo?       @relation(fields: [selectedVideoId], references: [id])
  artTemplate   ArtTemplate?     @relation(fields: [artTemplateId], references: [id])
  editor        User?            @relation(fields: [editedBy], references: [id])
  decisions     ReviewDecision[]
  publications  Publication[]

  @@unique([postId, versionNumber])
  @@index([postId])
  @@map("post_versions")
}

model ReviewDecision {
  id            String   @id @default(uuid()) @db.Uuid
  postVersionId String   @map("post_version_id") @db.Uuid
  reviewerId    String   @map("reviewer_id") @db.Uuid
  decision      String // 'approved' | 'rejected' | 'regenerate' | 'manual_edit'
  reason        String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  postVersion PostVersion @relation(fields: [postVersionId], references: [id])
  reviewer    User        @relation(fields: [reviewerId], references: [id])

  @@index([postVersionId])
  @@map("review_decisions")
}

model Publication {
  id               String    @id @default(uuid()) @db.Uuid
  postVersionId    String    @map("post_version_id") @db.Uuid
  instagramMediaId String?   @map("instagram_media_id")
  instagramPostUrl String?   @map("instagram_post_url")
  status           String // 'pending' | 'container_created' | 'published' | 'failed'
  errorMessage     String?   @map("error_message")
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  postVersion PostVersion @relation(fields: [postVersionId], references: [id])

  @@index([postVersionId])
  @@map("publications")
}

/**
 * Minimal audit trail: when a post is deleted by the automatic retention
 * cleanup (see the `cleanup_expired_posts()` function in the database), the
 * heavy record (photos, versions, decisions, publications) goes away, but this
 * row stays — only the essentials to answer "who posted what and when" if it
 * needs auditing later. No relation to Post: it no longer exists.
 */
model PostAuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  postId      String    @map("post_id") @db.Uuid
  /** No relation to Company on purpose (same reason as the post: it only filters the log by company). */
  companyId   String    @map("company_id") @db.Uuid
  title       String?
  /** Status of the post at the moment it was deleted ('published' | 'in_review' | 'failed'). */
  status      String
  authorName  String    @map("author_name")
  createdAt   DateTime  @map("created_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  purgedAt    DateTime  @default(now()) @map("purged_at") @db.Timestamptz(6)

  @@index([purgedAt])
  @@index([companyId])
  @@map("post_audit_log")
}

/**
 * Per-company settings — 1 row per company (it was global before
 * multi-tenancy). For now it only stores whether peer/editor review is
 * mandatory before publishing; turned off, the post publishes straight away as
 * soon as the art is saved, without going through "in review".
 */
model AppSettings {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @unique @map("company_id") @db.Uuid
  reviewRequired Boolean  @default(true) @map("review_required")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])

  @@map("app_settings")
}

/**
 * Failed sign-in attempts, used to throttle brute force (see
 * services/login-throttle.ts). Only failures are stored; a successful sign-in
 * clears the ones for that email. Rows older than a day are pruned by the
 * daily cron, so the table stays tiny.
 */
model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  /** Lower-cased email that was tried (it may not belong to any user). */
  email     String
  ip        String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
  @@map("login_attempts")
}
